{
	"name": "geoparquebr",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --emit-ts-declarations",
		"typecheck": "pnpm i18n && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:seed": "tsx --env-file=.env scripts/seed.ts",
		"models:fetch": "tsx --env-file=.env scripts/fetch-models.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"brand:images": "tsx scripts/generate-brand-images.ts"
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"@hookform/resolvers": "^6.0.0",
		"@inlang/paraglide-js": "2.29.1",
		"@mantine/core": "^7.17.8",
		"@mantine/hooks": "^7.17.8",
		"@phosphor-icons/react": "^2.1.10",
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.2",
		"@resvg/resvg-wasm": "2.6.2",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-start": "^1.169.3",
		"maplibre-gl": "^6.15.0",
		"mongodb": "^7.7.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.90.0",
		"satori": "0.62.0",
		"three": "^0.186.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@inlang/plugin-m-function-matcher": "2.3.4",
		"@inlang/plugin-message-format": "4.5.4",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.2",
		"meshoptimizer": "^1.3.0",
		"nitro": "3.0.260903-beta",
		"postcss": "^8.5.31",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
