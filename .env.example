# MongoDB Atlas connection string (Database Access user with readWrite on the db below)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="geoparquebr"

# Sketchfab API token, only for `pnpm models:fetch` (https://sketchfab.com/settings/password)
SKETCHFAB_TOKEN=""

# Vercel Cron sends it as a bearer token to /api/cron/sync-geosites.
# Any long random string; generate with: openssl rand -hex 32
CRON_SECRET="<random-secret>"

# Trip planner (agent/): Gemini free-tier key from Google AI Studio, no card
# needed (https://aistudio.google.com/apikey). Optional GEMINI_MODEL overrides
# the default model, e.g. when its free quota runs short.
GOOGLE_GENERATIVE_AI_API_KEY="<ai-studio-key>"
# GEMINI_MODEL="gemini-3.5-flash-lite"

# The planner is public; these cap messages per day (São Paulo time) so one
# visitor can't use up the free quota. Visitors are counted by a salted daily
# hash of their IP; set the salt to any long random string in production.
TRIP_AGENT_SALT="<random-secret>"
# TRIP_AGENT_VISITOR_LIMIT="20"
# TRIP_AGENT_DAILY_LIMIT="200"
# Shows the planner button in a production build ("1"); always on in dev.
# VITE_TRIP_AGENT="1"
