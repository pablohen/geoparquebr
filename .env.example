# MongoDB Atlas connection string (Database Access user with readWrite on the db below)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="geoparquebr"

# Sketchfab API token, only for `pnpm models:fetch` (https://sketchfab.com/settings/password)
SKETCHFAB_TOKEN=""

# Vercel Cron sends it as a bearer token to /api/cron/sync-geosites.
# Any long random string; generate with: openssl rand -hex 32
CRON_SECRET="<random-secret>"
